    {
      "id": "s002",
      "no": 2,
      "source": "Our brains evolved this ability to create an internal mental picture or model of the world in which we can rehearse forthcoming actions, without the risks or the penalties of doing them in the real world.",
      "translation": "우리의 뇌는 위험이나 불이익 없이 현실 세계에서 앞으로 할 행동을 머릿속으로 연습할 수 있는, 세계에 대한 내부의 정신적 그림이나 모형을 만들어 내는 능력을 발달시켰다.",
      "meaningSegments": [
        {"id": "s002-m01", "en": "Our brains evolved this ability", "ko": "우리의 뇌는 발달시켰다 이 능력을"},
        {"id": "s002-m02", "en": "to create an internal mental picture or model of the world", "ko": "만들어 내기 위한 내부의 정신적 그림이나 세계의 모형을"},
        {"id": "s002-m03", "en": "in which we can rehearse forthcoming actions,", "ko": "그 안에서 우리는 머릿속으로 연습할 수 있다 앞으로 할 행동을,"},
        {"id": "s002-m04", "en": "without the risks or the penalties", "ko": "위험이나 불이익 없이"},
        {"id": "s002-m05", "en": "of doing them in the real world.", "ko": "그것들을 현실 세계에서 하는 데 따르는."}
      ],
      "annotations": {
        "predicates": [
          {"id": "s002-m01-p01", "segmentId": "s002-m01", "en": [{"text": "evolved", "occurrence": 1}], "ko": [{"text": "발달시켰다", "occurrence": 1}]},
