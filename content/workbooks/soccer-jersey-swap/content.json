    {"id":"s001","no":1,"source":"Someone watching soccer for the first time might be surprised by what happens when the final whistle blows.","translation":"처음으로 축구를 보는 사람은 마지막 호루라기가 울릴 때 일어나는 일에 놀랄지도 모른다.","meaningSegments":[{"id":"s001-m01","en":"Someone watching soccer for the first time","ko":"처음으로 축구를 보는 사람은"},{"id":"s001-m02","en":"might be surprised","ko":"놀랄지도 모른다"},{"id":"s001-m03","en":"by what happens when the final whistle blows.","ko":"마지막 호루라기가 울릴 때 일어나는 일에."}],"annotations":{"predicates":[{"id":"s001-m02-p01","segmentId":"s001-m02","en":[{"text":"might be surprised","occurrence":1}],"ko":[{"text":"놀랄지도 모른다","occurrence":1}]}],"vocabulary":[{"id":"s001-m03-v01","segmentId":"s001-m03","colorSlot":1,"en":{"text":"final whistle","occurrence":1},"ko":{"text":"마지막 호루라기","occurrence":1},"meaning":"경기 종료를 알리는 호루라기"}]},"exercises":{"koBlank":{"targets":[{"id":"s001-ko-01","target":{"text":"놀랄지도 모른다","occurrence":1}}]},"enBlank":{"targets":[{"id":"s001-en-01","target":{"text":"surprised","occurrence":1}}]},"verb":{"targets":[{"id":"s001-verb-01","target":{"text":"might be surprised","occurrence":1},"cue":"might be surprised","lemma":"be surprised"}]},"choice":{"targets":[{"id":"s001-choice-01","target":{"text":"happens","occurrence":1},"options":["happens","happen"]}]},"arrange":{"chunks":[{"id":"s001-a","text":"Someone watching soccer for the first time"},{"id":"s001-b","text":"might be surprised by what happens when the final whistle blows."}],"displayOrder":["s001-b","s001-a"]},"writing":{"bank":["first time","might","surprised","final whistle"]}}},
    {"id":"s002","no":2,"source":"After an intense contest, the players take off their jerseys and swap them with members of the opposing team.","translation":"치열한 경기가 끝난 후, 선수들은 유니폼을 벗어 상대 팀 선수들과 교환한다.","meaningSegments":[{"id":"s002-m01","en":"After an intense contest,","ko":"치열한 경기가 끝난 후,"},{"id":"s002-m02","en":"the players take off their jerseys","ko":"선수들은 자신들의 유니폼을 벗는다"},{"id":"s002-m03","en":"and swap them with members of the opposing team.","ko":"그리고 그것을 상대 팀 선수들과 교환한다."}],"annotations":{"predicates":[{"id":"s002-m02-p01","segmentId":"s002-m02","en":[{"text":"take off","occurrence":1}],"ko":[{"text":"벗는다","occurrence":1}]},{"id":"s002-m03-p01","segmentId":"s002-m03","en":[{"text":"swap","occurrence":1}],"ko":[{"text":"교환한다","occurrence":1}]}],"vocabulary":[{"id":"s002-m01-v01","segmentId":"s002-m01","colorSlot":1,"en":{"text":"intense","occurrence":1},"ko":{"text":"치열한","occurrence":1},"meaning":"치열한"},{"id":"s002-m03-v02","segmentId":"s002-m03","colorSlot":2,"en":{"text":"opposing","occurrence":1},"ko":{"text":"상대","occurrence":1},"meaning":"상대의"}]},"exercises":{"koBlank":{"targets":[{"id":"s002-ko-01","target":{"text":"교환한다","occurrence":1}}]},"enBlank":{"targets":[{"id":"s002-en-01","target":{"text":"swap","occurrence":1}}]},"verb":{"targets":[{"id":"s002-verb-01","target":{"text":"take off","occurrence":1},"cue":"take off","lemma":"take off"},{"id":"s002-verb-02","target":{"text":"swap","occurrence":1},"cue":"swap","lemma":"swap"}]},"choice":{"targets":[{"id":"s002-choice-01","target":{"text":"their","occurrence":1},"options":["their","them"]}]},"arrange":{"chunks":[{"id":"s002-a","text":"After an intense contest,"},{"id":"s002-b","text":"the players take off their jerseys"},{"id":"s002-c","text":"and swap them with members of the opposing team."}],"displayOrder":["s002-c","s002-a","s002-b"]},"writing":{"bank":["intense contest","take off","jerseys","opposing team"]}}},
    {"id":"s003","no":3,"source":"It may seem strange, but this has been a soccer tradition since 1931, when players from France and England swapped shirts at the end of the match.","translation":"이것은 이상해 보일 수 있지만, 1931년부터 이어져 온 축구 전통이다. 당시 프랑스와 영국 선수들은 경기 끝에 셔츠를 교환했다.","meaningSegments":[{"id":"s003-m01","en":"It may seem strange,","ko":"그것은 이상해 보일 수 있지만,"},{"id":"s003-m02","en":"but this has been a soccer tradition since 1931,","ko":"이것은 1931년부터 축구 전통이었다"},{"id":"s003-m03","en":"when players from France and England swapped shirts at the end of the match.","ko":"그때 프랑스와 영국 선수들이 경기 끝에 셔츠를 교환했다."}],"annotations":{"predicates":[{"id":"s003-m01-p01","segmentId":"s003-m01","en":[{"text":"may seem","occurrence":1}],"ko":[{"text":"보일 수 있지만","occurrence":1}]},{"id":"s003-m02-p01","segmentId":"s003-m02","en":[{"text":"has been","occurrence":1}],"ko":[{"text":"이었다","occurrence":1}]}],"vocabulary":[{"id":"s003-m02-v01","segmentId":"s003-m02","colorSlot":1,"en":{"text":"tradition","occurrence":1},"ko":{"text":"전통","occurrence":1},"meaning":"전통"}]},"exercises":{"koBlank":{"targets":[{"id":"s003-ko-01","target":{"text":"축구 전통","occurrence":1}}]},"enBlank":{"targets":[{"id":"s003-en-01","target":{"text":"tradition","occurrence":1}}]},"verb":{"targets":[{"id":"s003-verb-01","target":{"text":"has been","occurrence":1},"cue":"be","lemma":"be"},{"id":"s003-verb-02","target":{"text":"swapped","occurrence":1},"cue":"swap","lemma":"swap"}]},"choice":{"targets":[{"id":"s003-choice-01","target":{"text":"has been","occurrence":1},"options":["has been","have been"]}]},"arrange":{"chunks":[{"id":"s003-a","text":"It may seem strange,"},{"id":"s003-b","text":"but this has been a soccer tradition since 1931,"},{"id":"s003-c","text":"when players from France and England swapped shirts at the end of the match."}],"displayOrder":["s003-c","s003-a","s003-b"]},"writing":{"bank":["may seem","tradition","since 1931","swapped shirts"]}}},
    {"id":"s004","no":4,"source":"Why do players swap shirts with their opponents?","translation":"선수들은 왜 상대 선수들과 셔츠를 교환할까?","meaningSegments":[{"id":"s004-m01","en":"Why do players swap shirts","ko":"왜 선수들은 셔츠를 교환하는가"},{"id":"s004-m02","en":"with their opponents?","ko":"상대 선수들과?"}],"annotations":{"predicates":[{"id":"s004-m01-p01","segmentId":"s004-m01","en":[{"text":"do","occurrence":1},{"text":"swap","occurrence":1}],"ko":[{"text":"교환하는가","occurrence":1}]}],"vocabulary":[{"id":"s004-m02-v01","segmentId":"s004-m02","colorSlot":1,"en":{"text":"opponents","occurrence":1},"ko":{"text":"상대 선수들","occurrence":1},"meaning":"상대 선수들"}]},"exercises":{"koBlank":{"targets":[{"id":"s004-ko-01","target":{"text":"상대 선수들","occurrence":1}}]},"enBlank":{"targets":[{"id":"s004-en-01","target":{"text":"opponents","occurrence":1}}]},"verb":{"targets":[{"id":"s004-verb-01","target":{"text":"do","occurrence":1},"cue":"do","lemma":"do"},{"id":"s004-verb-02","target":{"text":"swap","occurrence":1},"cue":"swap","lemma":"swap"}]},"choice":{"targets":[{"id":"s004-choice-01","target":{"text":"do","occurrence":1},"options":["do","does"]}]},"arrange":{"chunks":[{"id":"s004-a","text":"Why do players swap shirts"},{"id":"s004-b","text":"with their opponents?"}],"displayOrder":["s004-b","s004-a"]},"writing":{"bank":["why","players","swap shirts","opponents"]}}},
    {"id":"s005","no":5,"source":"It is to show that even though games are getting more intense these days, the spirit of fair play is still important.","translation":"그것은 요즘 경기가 더 치열해지고 있음에도 페어플레이 정신이 여전히 중요하다는 것을 보여 주기 위해서이다.","meaningSegments":[{"id":"s005-m01","en":"It is to show that","ko":"그것은 보여 주기 위해서이다"},{"id":"s005-m02","en":"even though games are getting more intense these days,","ko":"요즘 경기가 더 치열해지고 있음에도,"},{"id":"s005-m03","en":"the spirit of fair play is still important.","ko":"페어플레이 정신은 여전히 중요하다."}],"annotations":{"predicates":[{"id":"s005-m02-p01","segmentId":"s005-m02","en":[{"text":"are getting","occurrence":1}],"ko":[{"text":"치열해지고 있음에도","occurrence":1}]},{"id":"s005-m03-p01","segmentId":"s005-m03","en":[{"text":"is","occurrence":1}],"ko":[{"text":"중요하다","occurrence":1}]}],"vocabulary":[{"id":"s005-m03-v01","segmentId":"s005-m03","colorSlot":1,"en":{"text":"the spirit of fair play","occurrence":1},"ko":{"text":"페어플레이 정신","occurrence":1},"meaning":"공정하게 경기하려는 정신"}]},"exercises":{"koBlank":{"targets":[{"id":"s005-ko-01","target":{"text":"페어플레이 정신","occurrence":1}}]},"enBlank":{"targets":[{"id":"s005-en-01","target":{"text":"fair play","occurrence":1}}]},"verb":{"targets":[{"id":"s005-verb-01","target":{"text":"are getting","occurrence":1},"cue":"get","lemma":"get"},{"id":"s005-verb-02","target":{"text":"is","occurrence":1},"cue":"be","lemma":"be"}]},"choice":{"targets":[{"id":"s005-choice-01","target":{"text":"is","occurrence":1},"options":["is","are"]}]},"arrange":{"chunks":[{"id":"s005-a","text":"It is to show that"},{"id":"s005-b","text":"even though games are getting more intense these days,"},{"id":"s005-c","text":"the spirit of fair play is still important."}],"displayOrder":["s005-c","s005-a","s005-b"]},"writing":{"bank":["show that","even though","fair play","still important"]}}},
    {"id":"s006","no":6,"source":"For example, players from opposing teams help each other up after a foul.","translation":"예를 들어, 상대 팀 선수들은 반칙 후에 서로 일으켜 준다.","meaningSegments":[{"id":"s006-m01","en":"For example,","ko":"예를 들어,"},{"id":"s006-m02","en":"players from opposing teams help each other up","ko":"상대 팀 선수들은 서로 일으켜 준다"},{"id":"s006-m03","en":"after a foul.","ko":"반칙 후에."}],"annotations":{"predicates":[{"id":"s006-m02-p01","segmentId":"s006-m02","en":[{"text":"help","occurrence":1}],"ko":[{"text":"일으켜 준다","occurrence":1}]}],"vocabulary":[{"id":"s006-m03-v01","segmentId":"s006-m03","colorSlot":1,"en":{"text":"foul","occurrence":1},"ko":{"text":"반칙","occurrence":1},"meaning":"반칙"}]},"exercises":{"koBlank":{"targets":[{"id":"s006-ko-01","target":{"text":"서로 일으켜 준다","occurrence":1}}]},"enBlank":{"targets":[{"id":"s006-en-01","target":{"text":"each other","occurrence":1}}]},"verb":{"targets":[{"id":"s006-verb-01","target":{"text":"help","occurrence":1},"cue":"help","lemma":"help"}]},"choice":{"targets":[{"id":"s006-choice-01","target":{"text":"teams","occurrence":1},"options":["teams","team"]}]},"arrange":{"chunks":[{"id":"s006-a","text":"For example,"},{"id":"s006-b","text":"players from opposing teams help each other up"},{"id":"s006-c","text":"after a foul."}],"displayOrder":["s006-b","s006-c","s006-a"]},"writing":{"bank":["for example","opposing teams","each other","foul"]}}},
    {"id":"s007","no":7,"source":"Also, if an opponent gets injured, the ball is kicked out of play so that he or she receive medical treatment.","translation":"또한 상대 선수가 부상을 입으면, 그 또는 그녀가 치료를 받을 수 있도록 공은 경기장 밖으로 차여 나간다.","meaningSegments":[{"id":"s007-m01","en":"Also, if an opponent gets injured,","ko":"또한 상대 선수가 부상을 입으면,"},{"id":"s007-m02","en":"the ball is kicked out of play","ko":"공은 경기장 밖으로 차여 나간다"},{"id":"s007-m03","en":"so that he or she receive medical treatment.","ko":"그 또는 그녀가 치료를 받을 수 있도록."}],"annotations":{"predicates":[{"id":"s007-m01-p01","segmentId":"s007-m01","en":[{"text":"gets injured","occurrence":1}],"ko":[{"text":"부상을 입으면","occurrence":1}]},{"id":"s007-m02-p01","segmentId":"s007-m02","en":[{"text":"is kicked","occurrence":1}],"ko":[{"text":"차여 나간다","occurrence":1}]}],"vocabulary":[{"id":"s007-m03-v01","segmentId":"s007-m03","colorSlot":1,"en":{"text":"medical treatment","occurrence":1},"ko":{"text":"치료","occurrence":1},"meaning":"의료 치료"}]},"exercises":{"koBlank":{"targets":[{"id":"s007-ko-01","target":{"text":"경기장 밖으로","occurrence":1}}]},"enBlank":{"targets":[{"id":"s007-en-01","target":{"text":"injured","occurrence":1}}]},"verb":{"targets":[{"id":"s007-verb-01","target":{"text":"gets injured","occurrence":1},"cue":"get injured","lemma":"get injured"},{"id":"s007-verb-02","target":{"text":"is kicked","occurrence":1},"cue":"kick","lemma":"kick"}]},"choice":{"baseText":"Also, if an opponent gets injured, the ball is kicked out of play so that he or she receives medical treatment.","overrideReason":"원문의 subject-verb agreement 오류를 정답 문장으로 바로잡아 학습 문항을 구성함","targets":[{"id":"s007-choice-01","target":{"text":"receives","occurrence":1},"options":["receives","receive"]}]},"arrange":{"chunks":[{"id":"s007-a","text":"Also, if an opponent gets injured,"},{"id":"s007-b","text":"the ball is kicked out of play"},{"id":"s007-c","text":"so that he or she receive medical treatment."}],"displayOrder":["s007-c","s007-a","s007-b"]},"writing":{"bank":["opponent","injured","kicked out of play","medical treatment"]}}},
    {"id":"s008","no":8,"source":"Likewise, swapping jerseys shows that the game is being played in a friendly and fair spirit.","translation":"마찬가지로, 유니폼을 교환하는 것은 경기가 우호적이고 공정한 정신으로 진행되고 있음을 보여 준다.","meaningSegments":[{"id":"s008-m01","en":"Likewise, swapping jerseys shows that","ko":"마찬가지로 유니폼을 교환하는 것은 보여 준다"},{"id":"s008-m02","en":"the game is being played","ko":"경기가 진행되고 있음을"},{"id":"s008-m03","en":"in a friendly and fair spirit.","ko":"우호적이고 공정한 정신으로."}],"annotations":{"predicates":[{"id":"s008-m01-p01","segmentId":"s008-m01","en":[{"text":"shows","occurrence":1}],"ko":[{"text":"보여 준다","occurrence":1}]},{"id":"s008-m02-p01","segmentId":"s008-m02","en":[{"text":"is being played","occurrence":1}],"ko":[{"text":"진행되고 있음을","occurrence":1}]}],"vocabulary":[{"id":"s008-m03-v01","segmentId":"s008-m03","colorSlot":1,"en":{"text":"spirit","occurrence":1},"ko":{"text":"정신","occurrence":1},"meaning":"정신"}]},"exercises":{"koBlank":{"targets":[{"id":"s008-ko-01","target":{"text":"우호적이고 공정한","occurrence":1}}]},"enBlank":{"targets":[{"id":"s008-en-01","target":{"text":"friendly and fair","occurrence":1}}]},"verb":{"targets":[{"id":"s008-verb-01","target":{"text":"shows","occurrence":1},"cue":"show","lemma":"show"},{"id":"s008-verb-02","target":{"text":"is being played","occurrence":1},"cue":"be played","lemma":"play"}]},"choice":{"targets":[{"id":"s008-choice-01","target":{"text":"is","occurrence":1},"options":["is","are"]}]},"arrange":{"chunks":[{"id":"s008-a","text":"Likewise, swapping jerseys shows that"},{"id":"s008-b","text":"the game is being played"},{"id":"s008-c","text":"in a friendly and fair spirit."}],"displayOrder":["s008-b","s008-c","s008-a"]},"writing":{"bank":["likewise","swapping jerseys","being played","friendly and fair"]}}},
    {"id":"s009","no":9,"source":"The most famous jersey swap happened at the 1970 World Cup after Brazil's quarter-final victory over England.","translation":"가장 유명한 유니폼 교환은 브라질이 영국을 상대로 8강전에서 승리한 뒤 열린 1970년 월드컵에서 일어났다.","meaningSegments":[{"id":"s009-m01","en":"The most famous jersey swap happened","ko":"가장 유명한 유니폼 교환은 일어났다"},{"id":"s009-m02","en":"at the 1970 World Cup","ko":"1970년 월드컵에서"},{"id":"s009-m03","en":"after Brazil's quarter-final victory over England.","ko":"브라질이 영국을 상대로 8강전에서 승리한 뒤."}],"annotations":{"predicates":[{"id":"s009-m01-p01","segmentId":"s009-m01","en":[{"text":"happened","occurrence":1}],"ko":[{"text":"일어났다","occurrence":1}]}],"vocabulary":[{"id":"s009-m03-v01","segmentId":"s009-m03","colorSlot":1,"en":{"text":"quarter-final","occurrence":1},"ko":{"text":"8강전","occurrence":1},"meaning":"8강전"},{"id":"s009-m03-v02","segmentId":"s009-m03","colorSlot":2,"en":{"text":"victory","occurrence":1},"ko":{"text":"승리","occurrence":1},"meaning":"승리"}]},"exercises":{"koBlank":{"targets":[{"id":"s009-ko-01","target":{"text":"1970년 월드컵","occurrence":1}}]},"enBlank":{"targets":[{"id":"s009-en-01","target":{"text":"quarter-final","occurrence":1}}]},"verb":{"targets":[{"id":"s009-verb-01","target":{"text":"happened","occurrence":1},"cue":"happen","lemma":"happen"}]},"choice":{"targets":[{"id":"s009-choice-01","target":{"text":"most","occurrence":1},"options":["most","more"]}]},"arrange":{"chunks":[{"id":"s009-a","text":"The most famous jersey swap happened"},{"id":"s009-b","text":"at the 1970 World Cup"},{"id":"s009-c","text":"after Brazil's quarter-final victory over England."}],"displayOrder":["s009-c","s009-a","s009-b"]},"writing":{"bank":["most famous","1970 World Cup","quarter-final","victory"]}}},
    {"id":"s010","no":10,"source":"Brazil's greatest player ever, Pele, exchanged jerseys with England's greatest player ever, Bobby Moore.","translation":"브라질 역대 최고의 선수 펠레는 잉글랜드 역대 최고의 선수 바비 무어와 유니폼을 교환했다.","meaningSegments":[{"id":"s010-m01","en":"Brazil's greatest player ever, Pele,","ko":"브라질 역대 최고의 선수 펠레는"},{"id":"s010-m02","en":"exchanged jerseys","ko":"유니폼을 교환했다"},{"id":"s010-m03","en":"with England's greatest player ever, Bobby Moore.","ko":"잉글랜드 역대 최고의 선수 바비 무어와."}],"annotations":{"predicates":[{"id":"s010-m02-p01","segmentId":"s010-m02","en":[{"text":"exchanged","occurrence":1}],"ko":[{"text":"교환했다","occurrence":1}]}],"vocabulary":[{"id":"s010-m02-v01","segmentId":"s010-m02","colorSlot":1,"en":{"text":"exchanged","occurrence":1},"ko":{"text":"교환했다","occurrence":1},"meaning":"교환했다"}]},"exercises":{"koBlank":{"targets":[{"id":"s010-ko-01","target":{"text":"바비 무어","occurrence":1}}]},"enBlank":{"targets":[{"id":"s010-en-01","target":{"text":"exchanged","occurrence":1}}]},"verb":{"targets":[{"id":"s010-verb-01","target":{"text":"exchanged","occurrence":1},"cue":"exchange","lemma":"exchange"}]},"choice":{"targets":[{"id":"s010-choice-01","target":{"text":"Brazil's","occurrence":1},"options":["Brazil's","Brazil"]}]},"arrange":{"chunks":[{"id":"s010-a","text":"Brazil's greatest player ever, Pele,"},{"id":"s010-b","text":"exchanged jerseys"},{"id":"s010-c","text":"with England's greatest player ever, Bobby Moore."}],"displayOrder":["s010-b","s010-c","s010-a"]},"writing":{"bank":["Brazil's","greatest player","exchanged jerseys","Bobby Moore"]}}},
    {"id":"s011","no":11,"source":"The sight of these two great champions trading shirts is perhaps the most famous image in soccer history.","translation":"이 두 위대한 챔피언이 셔츠를 교환하는 모습은 아마도 축구 역사상 가장 유명한 장면일 것이다.","meaningSegments":[{"id":"s011-m01","en":"The sight of these two great champions trading shirts","ko":"이 두 위대한 챔피언이 셔츠를 교환하는 모습은"},{"id":"s011-m02","en":"is perhaps the most famous image","ko":"아마도 가장 유명한 장면이다"},{"id":"s011-m03","en":"in soccer history.","ko":"축구 역사상."}],"annotations":{"predicates":[{"id":"s011-m02-p01","segmentId":"s011-m02","en":[{"text":"is","occurrence":1}],"ko":[{"text":"이다","occurrence":1}]}],"vocabulary":[{"id":"s011-m01-v01","segmentId":"s011-m01","colorSlot":1,"en":{"text":"champions","occurrence":1},"ko":{"text":"챔피언","occurrence":1},"meaning":"챔피언들"}]},"exercises":{"koBlank":{"targets":[{"id":"s011-ko-01","target":{"text":"가장 유명한 장면","occurrence":1}}]},"enBlank":{"targets":[{"id":"s011-en-01","target":{"text":"soccer history","occurrence":1}}]},"verb":{"targets":[{"id":"s011-verb-01","target":{"text":"is","occurrence":1},"cue":"be","lemma":"be"}]},"choice":{"targets":[{"id":"s011-choice-01","target":{"text":"these","occurrence":1},"options":["these","this"]}]},"arrange":{"chunks":[{"id":"s011-a","text":"The sight of these two great champions trading shirts"},{"id":"s011-b","text":"is perhaps the most famous image"},{"id":"s011-c","text":"in soccer history."}],"displayOrder":["s011-b","s011-a","s011-c"]},"writing":{"bank":["sight","champions","trading shirts","soccer history"]}}},
    {"id":"s012","no":12,"source":"From that moment on, famous soccer stars like Pele needed more jerseys than other players since opposing players all wanted to swap jerseys with them.","translation":"그 순간부터 펠레 같은 유명 축구 스타들은 다른 선수들보다 더 많은 유니폼이 필요했는데, 상대 선수들이 모두 그들과 유니폼을 교환하고 싶어 했기 때문이다.","meaningSegments":[{"id":"s012-m01","en":"From that moment on,","ko":"그 순간부터,"},{"id":"s012-m02","en":"famous soccer stars like Pele needed more jerseys than other players","ko":"펠레 같은 유명 축구 스타들은 다른 선수들보다 더 많은 유니폼이 필요했다"},{"id":"s012-m03","en":"since opposing players all wanted to swap jerseys with them.","ko":"상대 선수들이 모두 그들과 유니폼을 교환하고 싶어 했기 때문에."}],"annotations":{"predicates":[{"id":"s012-m02-p01","segmentId":"s012-m02","en":[{"text":"needed","occurrence":1}],"ko":[{"text":"필요했다","occurrence":1}]},{"id":"s012-m03-p01","segmentId":"s012-m03","en":[{"text":"wanted","occurrence":1}],"ko":[{"text":"싶어 했기 때문에","occurrence":1}]}],"vocabulary":[{"id":"s012-m01-v01","segmentId":"s012-m01","colorSlot":1,"en":{"text":"From that moment on","occurrence":1},"ko":{"text":"그 순간부터","occurrence":1},"meaning":"그때부터"}]},"exercises":{"koBlank":{"targets":[{"id":"s012-ko-01","target":{"text":"더 많은 유니폼","occurrence":1}}]},"enBlank":{"targets":[{"id":"s012-en-01","target":{"text":"needed","occurrence":1}}]},"verb":{"targets":[{"id":"s012-verb-01","target":{"text":"needed","occurrence":1},"cue":"need","lemma":"need"},{"id":"s012-verb-02","target":{"text":"wanted","occurrence":1},"cue":"want","lemma":"want"}]},"choice":{"targets":[{"id":"s012-choice-01","target":{"text":"more","occurrence":1},"options":["more","most"]}]},"arrange":{"chunks":[{"id":"s012-a","text":"From that moment on,"},{"id":"s012-b","text":"famous soccer stars like Pele needed more jerseys than other players"},{"id":"s012-c","text":"since opposing players all wanted to swap jerseys with them."}],"displayOrder":["s012-c","s012-a","s012-b"]},"writing":{"bank":["from that moment on","stars like Pele","more jerseys","wanted to swap"]}}},
    {"id":"s013","no":13,"source":"Nowadays, jersey swapping happens at the end of every important match as an essential part of showing opponents friendship and respect.","translation":"오늘날 유니폼 교환은 상대에게 우정과 존중을 보여 주는 데 필수적인 부분으로서 모든 중요한 경기의 끝에 이루어진다.","meaningSegments":[{"id":"s013-m01","en":"Nowadays, jersey swapping happens","ko":"오늘날 유니폼 교환은 이루어진다"},{"id":"s013-m02","en":"at the end of every important match","ko":"모든 중요한 경기의 끝에"},{"id":"s013-m03","en":"as an essential part of showing opponents friendship and respect.","ko":"상대에게 우정과 존중을 보여 주는 필수적인 부분으로서."}],"annotations":{"predicates":[{"id":"s013-m01-p01","segmentId":"s013-m01","en":[{"text":"happens","occurrence":1}],"ko":[{"text":"이루어진다","occurrence":1}]}],"vocabulary":[{"id":"s013-m03-v01","segmentId":"s013-m03","colorSlot":1,"en":{"text":"essential","occurrence":1},"ko":{"text":"필수적인","occurrence":1},"meaning":"필수적인"},{"id":"s013-m03-v02","segmentId":"s013-m03","colorSlot":2,"en":{"text":"respect","occurrence":1},"ko":{"text":"존중","occurrence":1},"meaning":"존중"}]},"exercises":{"koBlank":{"targets":[{"id":"s013-ko-01","target":{"text":"필수적인 부분","occurrence":1}}]},"enBlank":{"targets":[{"id":"s013-en-01","target":{"text":"essential","occurrence":1}}]},"verb":{"targets":[{"id":"s013-verb-01","target":{"text":"happens","occurrence":1},"cue":"happen","lemma":"happen"}]},"choice":{"targets":[{"id":"s013-choice-01","target":{"text":"every","occurrence":1},"options":["every","all"]}]},"arrange":{"chunks":[{"id":"s013-a","text":"Nowadays, jersey swapping happens"},{"id":"s013-b","text":"at the end of every important match"},{"id":"s013-c","text":"as an essential part of showing opponents friendship and respect."}],"displayOrder":["s013-b","s013-c","s013-a"]},"writing":{"bank":["nowadays","every important match","essential part","friendship and respect"]}}},
    {"id":"s014","no":14,"source":"In fact, because of this, players are being supplied with extra jerseys!","translation":"사실, 이 때문에 선수들에게는 여분의 유니폼이 제공되고 있다!","meaningSegments":[{"id":"s014-m01","en":"In fact, because of this,","ko":"사실 이 때문에,"},{"id":"s014-m02","en":"players are being supplied","ko":"선수들에게 제공되고 있다"},{"id":"s014-m03","en":"with extra jerseys!","ko":"여분의 유니폼이!"}],"annotations":{"predicates":[{"id":"s014-m02-p01","segmentId":"s014-m02","en":[{"text":"are being supplied","occurrence":1}],"ko":[{"text":"제공되고 있다","occurrence":1}]}],"vocabulary":[{"id":"s014-m03-v01","segmentId":"s014-m03","colorSlot":1,"en":{"text":"extra","occurrence":1},"ko":{"text":"여분의","occurrence":1},"meaning":"여분의"},{"id":"s014-m02-v02","segmentId":"s014-m02","colorSlot":2,"en":{"text":"supplied","occurrence":1},"ko":{"text":"제공되고 있다","occurrence":1},"meaning":"제공되다"}]},"exercises":{"koBlank":{"targets":[{"id":"s014-ko-01","target":{"text":"여분의 유니폼","occurrence":1}}]},"enBlank":{"targets":[{"id":"s014-en-01","target":{"text":"supplied","occurrence":1}}]},"verb":{"targets":[{"id":"s014-verb-01","target":{"text":"are being supplied","occurrence":1},"cue":"be supplied","lemma":"supply"}]},"choice":{"targets":[{"id":"s014-choice-01","target":{"text":"are","occurrence":1},"options":["are","is"]}]},"arrange":{"chunks":[{"id":"s014-a","text":"In fact, because of this,"},{"id":"s014-b","text":"players are being supplied"},{"id":"s014-c","text":"with extra jerseys!"}],"displayOrder":["s014-c","s014-a","s014-b"]},"writing":{"bank":["in fact","because of this","being supplied","extra jerseys"]}}}
