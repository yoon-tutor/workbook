# Server runtime configuration template. Values are injected by Cloud Run
# (server/service.json via server/scripts/deploy.py); never commit real values.
# DATABASE_URL must point to the SAME shared database and schema as the TOEFL server.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
MCP_SHARED_SCHEMA=public
# Server-only HMAC secret for one-day download links (never a client tm_ key).
WORKBOOK_ARTIFACT_SIGNING_SECRET=
# Private release bucket (prepared/, reviewed/, published/, tenants/).
WORKBOOK_RELEASE_BUCKET=
# HTTPS origin used in signed artifact URLs (deploy.py sets the service URL).
WORKBOOK_PUBLIC_ORIGIN=
# Optional: published files up to this size are returned inline instead of as links (0 = links only).
WORKBOOK_ARTIFACT_INLINE_MAX_BYTES=0
HOST=127.0.0.1
PORT=8080
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# The server never reads client/.env; client keys are tm_ keys from the shared users/api_keys tables.
